<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>uAgent</AssemblyName>
    <RootNamespace>uAgent.Agent</RootNamespace>
    <Version>1.3.0</Version>
    <Product>uAgent Endpoint Agent</Product>
    <AssemblyTitle>uAgent Endpoint Agent</AssemblyTitle>
    <Company>Sumit Kumawat</Company>
    <Copyright>© 2026 Sumit Kumawat</Copyright>
    <Description>uAgent Endpoint Agent: installer and Windows service that reports to the uAgent manager. © 2026 Sumit Kumawat · Developed by Sumit Kumawat.</Description>
    <Authors>Sumit Kumawat</Authors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Single-file, self-contained Windows build used for the downloadable installer (scripts/build-agent.sh). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\uAgent.Shared\uAgent.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.32" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="System.DirectoryServices" Version="10.0.13" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishedDirectory="Never" />
  </ItemGroup>

</Project>
