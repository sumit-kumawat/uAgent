# uAgent portal settings for a local run. Copy to portal/.env (git-ignored) and adjust.
# Production installs keep these in /etc/uagent/portal.env (mode 600), written by scripts/install-centos.sh.
# Never commit real values.

# --- Network ---------------------------------------------------------------------------------------
# Interface to listen on. Empty = all interfaces (localhost, 127.0.0.1 and the server IP).
# 127.0.0.1 = this machine only (for example behind a local reverse proxy).
PORTAL_BIND_ADDRESS=
# Listen ports. Ports below 1024 need root or CAP_NET_BIND_SERVICE.
PORTAL_HTTP_PORT=8080
PORTAL_HTTPS_PORT=8443
# Ports clients use in links, when they differ from the listen ports (NAT, port forwarding, proxy).
# PUBLIC_HTTP_PORT=80
# PUBLIC_HTTPS_PORT=443
# Server IPv4 address offered to agents and put on the certificate. Empty = first LAN address.
# PUBLIC_IP=192.0.2.10
# Fallback host name, used only when the server has no IPv4 address. The DNS name is set in Settings.
# PUBLIC_HOST=uagent.example.com
# Redirect plain HTTP to HTTPS when a certificate is available. false only when a proxy terminates TLS.
FORCE_HTTPS=true
# Redirect browsers that use an unknown host name to the configured DNS name.
CANONICAL_REDIRECT=true
# Proxy addresses allowed to set X-Forwarded-For / X-Forwarded-Proto (Express "trust proxy").
# TRUST_PROXY=loopback

# --- Secrets (generate your own: openssl rand -hex 24) ---------------------------------------------
ENROLLMENT_KEY=
SESSION_SECRET=

# --- First account -----------------------------------------------------------------------------------
PORTAL_USER=admin
# Empty prints a one-time password to the log; a change is required at first sign-in.
PORTAL_PASS=

# --- TLS -----------------------------------------------------------------------------------------------
# Defaults: portal/certs/portal.crt and portal/certs/portal.key (npm run gencert creates them).
# TLS_CERT_FILE=
# TLS_KEY_FILE=
# TLS_CA_FILE=
# TLS_CA_KEY_FILE=

# --- State and agents ----------------------------------------------------------------------------------
# PORTAL_STATE_DIR=./data
# AGENT_REQUIRE_APPROVAL=false
# AGENT_HEARTBEAT_SECONDS=15
