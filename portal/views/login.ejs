<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Sign in · uAgent</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="icon" type="image/png" href="/icon.png?v=<%= locals.assetVersion || '' %>" />
    <link rel="stylesheet" href="/css/site.css?v=<%= locals.assetVersion || '' %>" />
</head>
<body>
<div class="login-page">
    <aside class="login-aside">
        <a class="brand" href="/login" aria-label="uAgent">
            <span class="brand-mark"><img src="/icon.png?v=<%= locals.assetVersion || '' %>" alt="" /></span>
            <span>uAgent</span>
            <span class="brand-sub">Endpoint Management</span>
        </a>
        <div>
            <h1>Central control for every Windows endpoint.</h1>
            <p>Monitor enrolled servers, VMs and workstations, manage accounts and run remote actions through the installed uAgent service.</p>
            <ul>
                <li><i class="bi bi-broadcast" aria-hidden="true"></i><span>Agents enroll automatically when they first check in.</span></li>
                <li><i class="bi bi-shield-lock" aria-hidden="true"></i><span>Authenticated agent connections and role-based access.</span></li>
                <li><i class="bi bi-journal-check" aria-hidden="true"></i><span>Every action is confirmed and recorded in the audit log.</span></li>
            </ul>
        </div>
        <div class="login-credit">&copy; 2026 Sumit Kumawat &middot; Developed by Sumit Kumawat</div>
    </aside>
    <main class="login-main">
        <div class="login-card">
            <h2>Sign in</h2>
            <div class="lead-text">Use your uAgent portal account.</div>
            <% if (error) { %>
                <div class="alert alert-danger py-2" role="alert">
                    <i class="bi bi-exclamation-circle me-1" aria-hidden="true"></i><%= error %>
                </div>
            <% } %>
            <form method="post" action="/login" novalidate autocomplete="off">
                <input type="hidden" name="returnUrl" value="<%= returnUrl %>" />
                <div class="mb-3">
                    <label class="form-label" for="username">Username</label>
                    <input class="form-control" id="username" name="username" autocomplete="off" autocapitalize="none" spellcheck="false" autofocus required />
                </div>
                <div class="mb-4">
                    <label class="form-label" for="password">Password</label>
                    <input type="password" class="form-control" id="password" name="password" autocomplete="off" required />
                </div>
                <button type="submit" class="btn btn-primary w-100 btn-signin">Sign in</button>
            </form>
            <div class="login-foot">
                <i class="bi <%= secure ? 'bi-lock-fill' : 'bi-unlock' %> me-1" aria-hidden="true"></i><%= secure ? "Encrypted connection" : "Unencrypted connection. Use https://" + publicHost + " where possible." %>
            </div>
            <% if (locals.installerAvailable) { %>
                <a class="btn btn-outline-secondary w-100 mt-3" href="<%= downloadUrl %>" download="<%= installerFileName %>">
                    <i class="bi bi-download me-1" aria-hidden="true"></i>Download <%= installerFileName %>
                </a>
                <div class="login-foot login-foot-tight">Download the agent installer without signing in.</div>
            <% } %>
        </div>
    </main>
</div>
</body>
</html>
