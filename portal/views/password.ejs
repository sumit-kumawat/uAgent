<%- include("partials/shell_top", { title: "Change password", breadcrumb: "Change password", active: "Settings" }) %>

<div class="page-fill">
    <div class="banner banner-warning"><i class="bi bi-key" aria-hidden="true"></i><div>Replace the initial password before using the portal. <button type="button" class="btn btn-link btn-sm p-0 align-baseline" data-open-password>Change password</button></div></div>
    <noscript>
        <div class="card password-card">
            <div class="card-header"><span>Set your password</span></div>
            <div class="card-body">
                <% if (error) { %>
                    <div class="alert alert-danger py-2" role="alert"><%= error %></div>
                <% } %>
                <form method="post" action="/account/password" autocomplete="off">
                    <div class="mb-3">
                        <label class="form-label" for="currentPassword">Current password</label>
                        <input type="password" class="form-control" id="currentPassword" name="currentPassword" autocomplete="off" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="newPassword">New password (at least 6 characters)</label>
                        <input type="password" class="form-control" id="newPassword" name="newPassword" autocomplete="new-password" minlength="6" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="confirmPassword">Confirm new password</label>
                        <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" autocomplete="new-password" minlength="6" required />
                    </div>
                    <button type="submit" class="btn btn-primary">Save password</button>
                </form>
            </div>
        </div>
    </noscript>
</div>

<%- include("partials/shell_bottom", { pageScript: null }) %>
