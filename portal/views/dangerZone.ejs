<%- include("partials/shell_top", { title: "Reset & Recovery", breadcrumb: "Reset & Recovery", active: "DangerZone" }) %>

<div class="page-fill">
    <div id="banners"></div>

    <section class="fill-card">
        <div class="card-header">
            <span>Manager connectivity</span>
            <span class="meta" id="connChecked"></span>
        </div>
        <div class="card-body">
            <p class="subtle mb-3">What an agent experiences when it contacts this portal right now. This is read-only; nothing is changed.</p>
            <div id="connectivity" class="dz-report"><span class="subtle">Checking…</span></div>
            <div class="mt-3">
                <button class="btn btn-sm btn-outline-secondary" id="recheck" type="button">
                    <i class="bi bi-arrow-clockwise me-1"></i>Check again
                </button>
            </div>
        </div>
    </section>

    <section class="fill-card mt-3">
        <div class="card-header"><span>Repair, update and reset</span></div>
        <div class="card-body p-0">
            <div id="operations" class="dz-ops"><span class="subtle p-3 d-block">Loading…</span></div>
        </div>
    </section>

    <section class="fill-card mt-3">
        <div class="card-header">
            <span>Backups</span>
            <button class="btn btn-sm btn-outline-secondary" id="newBackup" type="button">
                <i class="bi bi-plus-lg me-1"></i>Create a backup
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-wrap">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr><th>Taken</th><th>By</th><th>Reason</th><th>Size</th><th>Contents</th><th class="text-end">Actions</th></tr>
                    </thead>
                    <tbody id="backupRows"><tr><td colspan="6" class="subtle">Loading…</td></tr></tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="fill-card mt-3">
        <div class="card-header"><span>Recent operations</span></div>
        <div class="card-body p-0">
            <div class="table-wrap">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr><th>Started</th><th>Operation</th><th>By</th><th>Reason</th><th>Result</th><th class="text-end"></th></tr>
                    </thead>
                    <tbody id="historyRows"><tr><td colspan="6" class="subtle">Loading…</td></tr></tbody>
                </table>
            </div>
        </div>
    </section>
</div>

<!-- Confirmation and progress for every operation. Built here so the markup is shared and consistent. -->
<div class="modal fade" id="dz-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-shield-exclamation me-2"></i><span id="dz-title">Confirm</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="dz-body"></div>
            <div class="modal-footer">
                <span class="subtle me-auto" id="dz-note"></span>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" id="dz-cancel">Cancel</button>
                <button type="button" class="btn btn-danger" id="dz-run" disabled>Continue</button>
            </div>
        </div>
    </div>
</div>

<%- include("partials/shell_bottom", { pageScript: "/js/dangerZone.js" }) %>
