<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title><%= title %> · uAgent</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="icon" type="image/png" href="/icon.png?v=<%= locals.assetVersion || '' %>" />
    <link rel="stylesheet" href="/css/site.css?v=<%= locals.assetVersion || '' %>" />
</head>
<body data-role="<%= role %>" data-user="<%= user %>" data-must-change="<%= locals.mustChangePassword ? '1' : '' %>" data-needs-dns="<%= locals.needsDns ? '1' : '' %>" data-agent-url="<%= locals.agentContactUrl || '' %>">
<div class="app-shell">
    <header class="topbar">
        <a class="brand" href="/" aria-label="uAgent dashboard">
            <span class="brand-mark"><img src="/icon.png?v=<%= locals.assetVersion || '' %>" alt="" /></span>
            <span>uAgent</span>
            <span class="brand-sub">Endpoint Management</span>
        </a>
        <div class="global-search" id="globalSearch">
            <i class="bi bi-search"></i>
            <input type="search" id="globalSearchInput" placeholder="Search agents by ID, host, IP, DNS…" autocomplete="off" spellcheck="false" aria-label="Search agents" aria-expanded="false" aria-controls="globalSearchPanel" />
            <span class="search-spin" id="globalSearchSpin" hidden><i class="bi bi-arrow-repeat"></i></span>
            <button type="button" class="search-clear" id="globalSearchClear" hidden aria-label="Clear search"><i class="bi bi-x-lg"></i></button>
            <div class="search-panel" id="globalSearchPanel" hidden role="listbox"></div>
        </div>
        <div class="topbar-spacer"></div>
        <span class="host-chip" title="<%= secure ? 'Encrypted connection (HTTPS)' : 'Unencrypted connection (HTTP)' %>">
            <i class="bi <%= secure ? 'bi-lock-fill' : 'bi-unlock' %>"></i><%= publicHost %>
        </span>
        <div class="dropdown">
            <button class="user-menu" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
                <span class="avatar" aria-hidden="true"><%= (user || "?").substring(0, 2) %></span>
                <span class="user-meta">
                    <span class="name"><%= user %></span>
                    <span class="role"><%= role %></span>
                </span>
                <i class="bi bi-chevron-down small"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><span class="dropdown-item-text small text-muted">Signed in as <strong><%= user %></strong> · <%= role %></span></li>
                <li><hr class="dropdown-divider" /></li>
                <li><a class="dropdown-item" href="/settings"><i class="bi bi-gear me-2"></i>Settings</a></li>
                <li><button type="button" class="dropdown-item" data-open-password><i class="bi bi-key me-2"></i>Change password</button></li>
                <li><a class="dropdown-item" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>Sign out</a></li>
            </ul>
        </div>
    </header>
    <div class="app-body">
        <nav id="sidebar" class="sidebar" aria-label="Main">
            <div class="sidebar-nav">
                <div class="sidebar-label">Overview</div>
                <a class="nav-link <%= active === 'Dashboard' ? 'active' : '' %>" href="/"><i class="bi bi-grid"></i><span>Dashboard</span></a>
                <div class="sidebar-label">Manage</div>
                <a class="nav-link <%= active === 'Agents' ? 'active' : '' %>" href="/agents"><i class="bi bi-pc-display"></i><span>Agents</span></a>
                <a class="nav-link <%= active === 'Accounts' ? 'active' : '' %>" href="/accounts"><i class="bi bi-people"></i><span>Accounts</span></a>
                <a class="nav-link <%= active === 'Commands' ? 'active' : '' %>" href="/commands"><i class="bi bi-lightning-charge"></i><span>Actions</span></a>
                <div class="sidebar-label">Deploy</div>
                <a class="nav-link <%= active === 'Software' ? 'active' : '' %>" href="/software"><i class="bi bi-box-seam"></i><span>Software</span></a>
                <a class="nav-link <%= active === 'AgentDeployment' ? 'active' : '' %>" href="/agent-deployment"><i class="bi bi-cloud-arrow-up"></i><span>Agent Deployment</span></a>
                <div class="sidebar-label">Governance</div>
                <a class="nav-link <%= active === 'Audit' ? 'active' : '' %>" href="/audit"><i class="bi bi-shield-check"></i><span>Audit Log</span></a>
                <a class="nav-link <%= active === 'Settings' ? 'active' : '' %>" href="/settings"><i class="bi bi-sliders"></i><span>Settings</span></a>
            </div>
            <div class="sidebar-foot">
                <a class="sidebar-download <%= active === 'Download' ? 'active' : '' %>" href="/downloads">
                    <span class="icon"><i class="bi bi-download"></i></span>
                    <span class="text"><span class="title">Agent Download</span><span class="sub">Windows installer</span></span>
                    <i class="bi bi-chevron-right chevron"></i>
                </a>
            </div>
        </nav>
        <div class="workspace">
            <header class="page-head">
                <div>
                    <% if (typeof crumbs !== "undefined" && crumbs && crumbs.length) { %>
                        <div class="page-crumbs">
                            <% crumbs.forEach(function (c, i) { %><% if (i > 0) { %> / <% } %><a href="<%= c.href %>"><%= c.label %></a><% }); %>
                        </div>
                    <% } %>
                    <h1><%= breadcrumb %></h1>
                </div>
            </header>
            <main class="content">
                <% if (locals.needsDns && !locals.mustChangePassword) { %>
                    <div class="banner banner-warning"><i class="bi bi-hdd-network"></i><div>Agents contact this server at <span class="mono"><%= agentContactUrl %></span>. <a href="/settings" data-open-host>Set a DNS name or FQDN</a> so new downloads and installed agents use it.</div></div>
                <% } %>
