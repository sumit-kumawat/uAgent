<%- include("partials/shell_top", { title: "Targets", breadcrumb: "Targets", crumbs: [{ label: "Deployment Center", href: "/deployment-center" }], active: "DeploymentCenter" }) %>

<%- include("partials/dc_nav", { dcActive: "targets" }) %>

<div class="page-fill">
    <div id="banners" class="d-flex flex-column gap-2"></div>

    <section class="card" id="formCard">
        <div class="card-header"><span>Validate targets</span></div>
        <div class="card-body">
            <form id="valForm" novalidate autocomplete="off">
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label" for="valKind">What are you targeting?</label>
                        <select class="form-select form-select-sm" id="valKind">
                            <option value="software">Software deployment</option>
                            <option value="agent">Agent installation</option>
                        </select>
                    </div>
                </div>
                <div class="choice-grid mb-3" role="radiogroup" aria-label="Target source">
                    <label class="choice"><input class="form-check-input" type="radio" name="valSource" value="text" checked /><span><span class="title">Enter systems</span><span class="desc">One per line, or separated by commas, semicolons or spaces.</span></span></label>
                    <label class="choice"><input class="form-check-input" type="radio" name="valSource" value="file" /><span><span class="title">Import CSV or Excel</span><span class="desc">.csv or .xlsx, up to 10 MB.</span></span></label>
                </div>
                <div class="mb-3" id="valTextWrap">
                    <label class="form-label" for="valText">Systems</label>
                    <textarea class="form-control form-control-sm mono" id="valText" rows="8" spellcheck="false" placeholder="pc-0142&#10;pc-0142.corp.example.com&#10;192.0.2.25&#10;2001:db8::25"></textarea>
                </div>
                <div class="mb-3" id="valFileWrap" hidden>
                    <label class="form-label" for="valFile">System list</label>
                    <input class="form-control form-control-sm" type="file" id="valFile" accept=".csv,.xlsx" aria-describedby="valFileHelp" />
                    <div class="form-text" id="valFileHelp">Each row needs a hostname, FQDN or IP column. Optional: site, group, os.</div>
                </div>
                <div class="check-list mb-3">
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="valDns" checked /><label class="form-check-label" for="valDns">Resolve DNS</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" id="valReach" checked /><label class="form-check-label" for="valReach">Check reachability</label></div>
                </div>
                <div class="alert alert-danger py-2 mb-3" role="alert" id="valError" hidden></div>
                <button class="btn btn-sm btn-primary" type="submit" id="valSubmit"><i class="bi bi-shield-check me-1" aria-hidden="true"></i>Validate</button>
            </form>
            <div id="valProgress" hidden class="mt-3">
                <div class="d-flex justify-content-between mb-1">
                    <span class="subtle" id="valProgressLabel">Checking systems…</span>
                    <span class="subtle" id="valProgressStatus"></span>
                </div>
                <div class="seg-bar seg-lg"><span class="seg-run" id="valBar" style="width:0%"></span></div>
            </div>
        </div>
    </section>

    <section class="fill-card tabs-card" id="resultsCard" hidden>
        <div class="card-header">
            <span>Results</span>
            <span class="meta d-flex align-items-center gap-2">
                <span id="resultsMeta"></span>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="valReset"><i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>Validate another list</button>
            </span>
        </div>
        <div class="card-body">
            <div class="tile-grid" id="sumTiles"></div>
            <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mt-3">
                <div class="d-flex flex-wrap gap-2" id="actionsBar">
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="actGroup" data-admin hidden><i class="bi bi-collection me-1" aria-hidden="true"></i>Save as target group</button>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="actDeploy" data-admin hidden><i class="bi bi-rocket-takeoff me-1" aria-hidden="true"></i>Deploy software</button>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="actImport" data-admin hidden><i class="bi bi-list-check me-1" aria-hidden="true"></i>Create agent installation plan</button>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="actExport"><i class="bi bi-download me-1" aria-hidden="true"></i>Export CSV</button>
            </div>
        </div>
        <div class="toolbar">
            <div class="search">
                <i class="bi bi-search"></i>
                <input type="search" class="form-control form-control-sm" id="recordSearch" placeholder="Search host, FQDN, IP, site, group…" aria-label="Search records" autocomplete="off" />
            </div>
            <span class="count" id="recordCount"></span>
        </div>
        <div class="fill-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th class="num">Row</th>
                        <th>System</th>
                        <th>Site</th>
                        <th>Group</th>
                        <th>OS</th>
                        <th>Issues</th>
                        <th>DNS</th>
                        <th>Reachability</th>
                        <th>Agent</th>
                        <th>Eligible</th>
                        <th>Reason</th>
                    </tr>
                </thead>
                <tbody id="recordBody">
                    <tr><td colspan="11" class="empty">Validate a list of systems to see results here.</td></tr>
                </tbody>
            </table>
        </div>
        <div class="pager" id="recordPager" hidden>
            <span id="pageInfo"></span>
            <div class="d-flex align-items-center gap-2">
                <label class="subtle" for="pageSize">Rows per page</label>
                <select class="form-select form-select-sm" id="pageSize" style="width:auto;">
                    <option value="25">25</option>
                    <option value="50" selected>50</option>
                    <option value="100">100</option>
                    <option value="250">250</option>
                </select>
                <div class="pages" id="pageButtons"></div>
            </div>
        </div>
    </section>
</div>

<div class="modal fade" id="groupModal" tabindex="-1" aria-labelledby="groupTitle" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" id="groupForm" novalidate autocomplete="off">
            <div class="modal-header">
                <h2 class="modal-title" id="groupTitle"><i class="bi bi-collection me-2" aria-hidden="true"></i>Save as target group</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted">Creates a static target group from the managed, eligible systems in this list.</p>
                <div class="mb-3"><label class="form-label" for="grpName">Name</label><input class="form-control form-control-sm" id="grpName" maxlength="100" required /></div>
                <div class="mb-3">
                    <label class="form-label" for="grpCategory">Category</label>
                    <select class="form-select form-select-sm" id="grpCategory">
                        <option value="site">Site</option>
                        <option value="lab">Lab</option>
                        <option value="environment">Environment</option>
                        <option value="department">Department</option>
                        <option value="other" selected>Other</option>
                    </select>
                </div>
                <div class="mb-3"><label class="form-label" for="grpDesc">Description</label><input class="form-control form-control-sm" id="grpDesc" maxlength="500" /></div>
                <div class="alert alert-danger py-2 mt-3 mb-0" role="alert" id="grpError" hidden></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-sm btn-primary" id="grpSave">Save group</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importTitle" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" id="importForm" novalidate autocomplete="off">
            <div class="modal-header">
                <h2 class="modal-title" id="importTitle"><i class="bi bi-list-check me-2" aria-hidden="true"></i>Create agent installation plan</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted">Plans install, upgrade, repair or no action for each valid system in this list, and generates the deployment kit for systems without an agent.</p>
                <div class="mb-3"><label class="form-label" for="impName">Name</label><input class="form-control form-control-sm" id="impName" maxlength="120" placeholder="Finance laptops, October" required /></div>
                <div class="alert alert-danger py-2 mt-3 mb-0" role="alert" id="impError" hidden></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-sm btn-primary" id="impSave">Create plan</button>
            </div>
        </form>
    </div>
</div>

<%- include("partials/shell_bottom", { pageScript: "/js/targets.js" }) %>
