<%- include("partials/shell_top", { title: "Accounts", breadcrumb: "Accounts", active: "Accounts" }) %>

<div class="page-fill">
    <div class="stat-strip stat-strip-card">
        <div><div class="label">Accounts</div><div class="value" id="cTotal">0</div></div>
        <div><div class="label">Need attention</div><div class="value" id="cAttention">0</div></div>
        <div><div class="label">Locked out</div><div class="value" id="cLocked">0</div></div>
        <div><div class="label">Disabled</div><div class="value" id="cDisabled">0</div></div>
        <div><div class="label">Local</div><div class="value" id="cLocal">0</div></div>
        <div><div class="label">Domain</div><div class="value" id="cDomain">0</div></div>
    </div>
    <section class="fill-card">
        <div class="card-header">
            <span>Accounts across agents</span>
            <span class="meta" id="lastUpdated"></span>
        </div>
        <div class="card-body p-0">
            <div class="toolbar">
                <div class="search">
                    <i class="bi bi-search"></i>
                    <input type="search" class="form-control form-control-sm" id="nameFilter" placeholder="Search account, display name, group, host" aria-label="Search accounts" />
                </div>
                <select class="form-select form-select-sm" id="agentFilter" aria-label="Filter by agent">
                    <option value="">All agents</option>
                </select>
                <select class="form-select form-select-sm" id="sourceFilter" aria-label="Filter by source">
                    <option value="">Local and domain</option>
                    <option value="Local">Local accounts</option>
                    <option value="Domain">Domain accounts</option>
                </select>
                <select class="form-select form-select-sm" id="stateFilter" aria-label="Filter by state">
                    <option value="All">All states</option>
                    <option value="Attention">Needs attention</option>
                    <option value="Enabled">Enabled</option>
                    <option value="Disabled">Disabled</option>
                    <option value="Locked">Locked out</option>
                    <option value="Expired">Expired account</option>
                    <option value="PasswordExpired">Expired password (enabled)</option>
                    <option value="PasswordWarning">Password expiring (enabled)</option>
                    <option value="PasswordUnset">Password not set</option>
                    <option value="Admins">Local administrators</option>
                    <option value="Protected">Protected accounts</option>
                </select>
                <span class="count" id="accountCount"></span>
            </div>
            <div class="fill-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th style="width:96px;">Agent ID</th>
                            <th class="sortable" data-sort="machine" tabindex="0">Machine</th>
                            <th class="sortable" data-sort="account" tabindex="0">Account</th>
                            <th>Source</th>
                            <th>Groups</th>
                            <th>Enabled</th>
                            <th>Locked out</th>
                            <th>Password</th>
                            <th class="sortable" data-sort="passwordSet" tabindex="0">Password last set</th>
                            <th class="sortable" data-sort="lastLogon" tabindex="0">Last logon</th>
                            <th style="width:110px;"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody id="accountsBody">
                        <tr><td colspan="11" class="empty">Loading…</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="pager" id="pager" hidden></div>
        </div>
    </section>
</div>

<%- include("partials/shell_bottom", { pageScript: "/js/accounts.js" }) %>
